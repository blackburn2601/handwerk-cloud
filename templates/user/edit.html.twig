{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}{{ user.firstname }} {{ user.surname }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_user_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>
    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('user-cog', 20) }}</span>
            <div>
                <h1>{{ user.firstname }} {{ user.surname }}</h1>
                <div class="page-sub">{{ user.email }}</div>
            </div>
        </div>
    </div>
    <div class="card"><div class="card-body">
        {{ include('user/_form.html.twig', {'delete_form': true}) }}
    </div></div>
{% endblock %}
