{% import '_icons.html.twig' as ui %}

<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}"
      data-confirm="Möchten Sie diesen Benutzer wirklich löschen?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger" type="submit">{{ ui.icon('trash') }} Löschen</button>
</form>
