{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}{{ user.firstname }} {{ user.surname }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_user_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>
    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('user-cog', 20) }}</span>
            <div>
                <h1>{{ user.firstname }} {{ user.surname }}</h1>
                <div class="page-sub">{{ user.email }}</div>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">{{ ui.icon('pencil') }} Bearbeiten</a>
        </div>
    </div>
    <div class="card"><div class="card-body">
        <div class="form-grid">
            <div class="field"><span class="form-label">Rollen</span>
                <div>{% for role in user.roles %}<span class="badge {{ role == 'ROLE_ADMIN' ? 'is-brand' }}">{{ role }}</span> {% endfor %}</div>
            </div>
            <div class="field"><span class="form-label">Kunden</span><div>{{ user.customers|length }}</div></div>
            <div class="field"><span class="form-label">Angebote</span><div>{{ user.offers|length }}</div></div>
            <div class="field"><span class="form-label">Aufträge</span><div>{{ user.tasks|length }}</div></div>
        </div>
    </div></div>
{% endblock %}
