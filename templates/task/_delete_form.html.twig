{% import '_icons.html.twig' as ui %}

{% if task.offer %}
    <form method="post" action="{{ path('app_offer_delete', {'id': task.offer.id}) }}"
          data-confirm="Damit werden Angebot und Auftrag gelöscht. Fortfahren?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.offer.id) }}">
        <button class="btn btn-danger" type="submit">{{ ui.icon('trash') }} Löschen</button>
    </form>
{% endif %}
