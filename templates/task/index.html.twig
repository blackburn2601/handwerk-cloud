{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Aufträge · HandwerkCloud{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('wrench', 20) }}</span>
            <div>
                <h1>Aufträge</h1>
                <div class="page-sub">{{ tasks|length }} {{ tasks|length == 1 ? 'Eintrag' : 'Einträge' }}</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body is-flush">
            {% if tasks is empty %}
                <div class="empty">
                    {{ ui.icon('wrench', 40) }}
                    <p>Noch keine Aufträge. Aufträge entstehen aus angenommenen Angeboten.</p>
                    <a class="btn btn-primary" href="{{ path('app_offer_index') }}">{{ ui.icon('file') }} Zu den Angeboten</a>
                </div>
            {% else %}
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Kunde</th>
                            <th>Kontakt</th>
                            <th>Ort</th>
                            <th>Termin</th>
                            <th>Medien</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for task in tasks %}
                            <tr>
                                <td class="id-cell">{{ task.id }}</td>
                                <td class="is-strong">
                                    {% if task.customer %}{{ task.customer.firstname }} {{ task.customer.surname }}{% else %}—{% endif %}
                                </td>
                                <td>
                                    {% if task.customer %}
                                        {{ task.customer.phone }}
                                        {% if task.customer.email %}<div class="muted" style="font-size:.8rem">{{ task.customer.email }}</div>{% endif %}
                                    {% endif %}
                                </td>
                                <td>{% if task.customer %}{{ task.customer.plz }} {{ task.customer.city }}{% endif %}</td>
                                <td>{{ task.taskDate ? task.taskDate|date('d.m.Y') : '—' }}</td>
                                <td>
                                    <span class="badge">{{ ui.icon('image', 13) }} {{ task.taskImages|length }}</span>
                                    <span class="badge">{{ ui.icon('brush', 13) }} {{ task.taskDraws|length }}</span>
                                </td>
                                <td class="is-actions">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_task_edit', {'id': task.id}) }}">
                                        {{ ui.icon('pencil', 15) }} Bearbeiten
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
