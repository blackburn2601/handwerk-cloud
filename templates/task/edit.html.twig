{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Auftrag {{ task.id }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_task_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>

    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('wrench', 20) }}</span>
            <div>
                <h1>Auftrag bearbeiten</h1>
                <div class="page-sub">
                    {% if task.customer %}{{ task.customer.firstname }} {{ task.customer.surname }}{% endif %}
                    {% if task.offer %} · aus Angebot {{ task.offer.id }}{% endif %}
                </div>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-secondary" href="{{ path('app_task_archive', {'id': task.id}) }}">
                {{ ui.icon('download') }} Medien als ZIP
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="form-grid is-single">
                    {{ form_row(form.customer) }}
                </div>
                <div class="form-grid">
                    {{ form_row(form.comment) }}
                    {{ form_row(form.taskImages) }}
                    {{ form_row(form.taskDate) }}
                    {{ form_row(form.termDate) }}
                </div>
                <div class="form-grid is-single">
                    {{ form_row(form.textarea) }}
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">{{ ui.icon('check') }} Speichern</button>
                    {% if task.offer %}
                        <a class="btn btn-secondary" href="{{ path('app_offer_edit', {'id': task.offer.id}) }}">
                            {{ ui.icon('file') }} Zum Angebot
                        </a>
                    {% endif %}
                    <span class="spacer"></span>
                    {{ include('task/_delete_form.html.twig') }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {{ include('_media_section.html.twig', {
        heading: 'Fotos',
        icon_name: 'image',
        items: task.taskImages,
        dir: taskimages_dir,
        delete_route: 'app_task_image_delete',
        confirm: 'Möchten Sie das Bild wirklich löschen? Dieser Vorgang kann nicht rückgängig gemacht werden.',
        empty_text: 'Noch keine Fotos hochgeladen.'
    }) }}

    {{ include('_media_section.html.twig', {
        heading: 'Zeichnungen',
        icon_name: 'brush',
        items: task.taskDraws,
        dir: taskdrawings_dir,
        delete_route: 'app_task_draw_delete',
        confirm: 'Möchten Sie die Zeichnung wirklich löschen? Dieser Vorgang kann nicht rückgängig gemacht werden.',
        add_url: task.offer ? path('app_task_draw_new', {'id': task.offer.id}) : null,
        empty_text: 'Noch keine Zeichnungen angelegt.',
        fit: 'contain'
    }) }}
{% endblock %}
