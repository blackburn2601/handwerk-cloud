{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Angebot {{ offer.id }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_offer_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>

    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('file', 20) }}</span>
            <div>
                <h1>Angebot bearbeiten</h1>
                <div class="page-sub">
                    {% if offer.customer %}{{ offer.customer.firstname }} {{ offer.customer.surname }} · {% endif %}
                    {{ offer.offerDate ? offer.offerDate|date('d.m.Y') : '' }}
                </div>
            </div>
        </div>
        <div class="page-actions">
            {% if offer.task %}
                <span class="badge is-green">{{ ui.icon('check', 13) }} Auftrag erstellt</span>
            {% else %}
                <span class="badge">offen</span>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('offer/_form.html.twig') }}
        </div>
    </div>

    {{ include('_media_section.html.twig', {
        heading: 'Fotos',
        icon_name: 'image',
        items: offer.taskImages,
        dir: taskimages_dir,
        delete_route: 'app_task_image_delete',
        confirm: 'Möchten Sie das Bild wirklich löschen? Dieser Vorgang kann nicht rückgängig gemacht werden.',
        empty_text: 'Noch keine Fotos hochgeladen.'
    }) }}

    {{ include('_media_section.html.twig', {
        heading: 'Zeichnungen',
        icon_name: 'brush',
        items: offer.taskDraws,
        dir: taskdrawings_dir,
        delete_route: 'app_task_draw_delete',
        confirm: 'Möchten Sie die Zeichnung wirklich löschen? Dieser Vorgang kann nicht rückgängig gemacht werden.',
        add_url: path('app_task_draw_new', {'id': offer.id}),
        empty_text: 'Noch keine Zeichnungen angelegt.',
        fit: 'contain'
    }) }}
{% endblock %}
