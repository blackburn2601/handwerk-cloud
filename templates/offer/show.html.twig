{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Angebot {{ offer.id }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_offer_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>

    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('file', 20) }}</span>
            <div>
                <h1>Angebot {{ offer.id }}</h1>
                <div class="page-sub">{{ offer.comment ?: 'Ohne Anmerkung' }}</div>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" href="{{ path('app_offer_edit', {'id': offer.id}) }}">{{ ui.icon('pencil') }} Bearbeiten</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="form-grid">
                <div class="field">
                    <span class="form-label">Kunde</span>
                    <div>{% if offer.customer %}{{ offer.customer.firstname }} {{ offer.customer.surname }}{% else %}—{% endif %}</div>
                </div>
                <div class="field">
                    <span class="form-label">Termin</span>
                    <div>{{ offer.termDate ? offer.termDate|date('d.m.Y H:i') : '—' }}</div>
                </div>
                <div class="field">
                    <span class="form-label">Angebotsdatum</span>
                    <div>{{ offer.offerDate ? offer.offerDate|date('d.m.Y H:i') : '—' }}</div>
                </div>
                <div class="field">
                    <span class="form-label">Erstellt</span>
                    <div>{{ offer.created ? offer.created|date('d.m.Y') : '—' }}</div>
                </div>
            </div>
            <div class="field">
                <span class="form-label">Freitext</span>
                <div>{{ offer.textarea|nl2br ?: '—' }}</div>
            </div>
        </div>
    </div>
{% endblock %}
