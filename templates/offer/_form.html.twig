{% import '_icons.html.twig' as ui %}

{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-grid is-single">
        {{ form_row(form.customer) }}
    </div>
    <div class="form-grid">
        {{ form_row(form.comment) }}
        {{ form_row(form.taskImages) }}
        {{ form_row(form.offerDate) }}
        {{ form_row(form.termDate) }}
    </div>
    <div class="form-grid is-single">
        {{ form_row(form.textarea) }}
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" type="submit">{{ ui.icon('check') }} {{ button_label|default('Speichern') }}</button>
        {% if offer.id %}
            {% if offer.task %}
                <a class="btn btn-secondary" href="{{ path('app_task_edit', {'id': offer.task.id}) }}">
                    {{ ui.icon('wrench') }} Zum Auftrag
                </a>
            {% else %}
                <a class="btn btn-secondary" href="{{ path('app_offer_generate_task', {'id': offer.id}) }}">
                    {{ ui.icon('arrow-right') }} Auftrag erstellen
                </a>
            {% endif %}
            <span class="spacer"></span>
            {{ include('offer/_delete_form.html.twig') }}
        {% else %}
            <a class="btn btn-secondary" href="{{ path('app_offer_index') }}">Abbrechen</a>
        {% endif %}
    </div>
{{ form_end(form) }}
