{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Angebot erstellen · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_offer_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>

    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('file', 20) }}</span>
            <div>
                <h1>Angebot erstellen</h1>
                <div class="page-sub">Fotos und Zeichnungen lassen sich nach dem Speichern ergänzen</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('offer/_form.html.twig', {'button_label': 'Angebot erstellen'}) }}
        </div>
    </div>
{% endblock %}
