{% extends 'base.html.twig' %}

{% block title %}Neues Angebot{% endblock %}

{% block body %}
    <h1><i class="fas fa-file-invoice"></i> Angebot anlegen</h1>

    {{ form_start(form) }}
    <div class="my-custom-class-for-errors">
        {{ form_errors(form) }}
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.customer, {'attr': {'class': 'form-control form-select'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.comment, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.textarea, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.offerDate, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.termDate, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <br>
    <button class="btn btn-success btn-icon-split">
        <span class="icon text-white-50">
            <i class="fas fa-check"></i>
        </span>
        <span class="text">{{ button_label|default('Speichern') }}</span>
    </button>
    {{ form_end(form) }}
    <br>
    <a href="{{ path('app_offer_index') }}">Zurück zur Übersicht</a>
{% endblock %}
