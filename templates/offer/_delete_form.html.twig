{% import '_icons.html.twig' as ui %}

<form method="post" action="{{ path('app_offer_delete', {'id': offer.id}) }}"
      data-confirm="Möchten Sie das Angebot wirklich löschen?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offer.id) }}">
    <button class="btn btn-danger" type="submit">{{ ui.icon('trash') }} Löschen</button>
</form>
