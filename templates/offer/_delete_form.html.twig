<form method="post" action="{{ path('app_offer_delete', {'id': offer.id}) }}" onsubmit="return confirm('Möchten Sie das Angebot wirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ offer.id) }}">
    <button class="btn btn-danger btn-icon-split">
        <span class="icon text-white-50">
            <i class="fas fa-trash"></i>
        </span>
        <span class="text">Löschen</span>
    </button>
</form>
