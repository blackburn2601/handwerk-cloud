{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Suche · HandwerkCloud{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('search', 20) }}</span>
            <div>
                <h1>Suche</h1>
                <div class="page-sub">
                    {% if term %}
                        {{ customers|length + offers|length + tasks|length }} Treffer für „{{ term }}“
                    {% else %}
                        Suchen Sie nach Name, PLZ oder Ort
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if not term %}
        <div class="card"><div class="card-body">
            <div class="empty">
                {{ ui.icon('search', 40) }}
                <p>Bitte geben Sie einen Suchbegriff ein.</p>
            </div>
        </div></div>
    {% else %}
        <div class="card result-section">
            <div class="card-head">
                <h2>Kunden</h2><span class="result-count">{{ customers|length }}</span>
            </div>
            <div class="card-body is-flush">
                {% if customers is empty %}
                    <div class="empty" style="padding:2rem">Keine Kunden gefunden.</div>
                {% else %}
                    <div class="table-wrap"><table class="data">
                        <thead><tr><th>#</th><th>Name</th><th>Ort</th><th></th></tr></thead>
                        <tbody>
                        {% for customer in customers %}
                            <tr>
                                <td class="id-cell">{{ customer.id }}</td>
                                <td class="is-strong">{{ customer.firstname }} {{ customer.surname }}</td>
                                <td>{{ customer.plz }} {{ customer.city }}</td>
                                <td class="is-actions">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_customer_edit', {'id': customer.id}) }}">Öffnen</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table></div>
                {% endif %}
            </div>
        </div>

        <div class="card result-section">
            <div class="card-head">
                <h2>Angebote</h2><span class="result-count">{{ offers|length }}</span>
            </div>
            <div class="card-body is-flush">
                {% if offers is empty %}
                    <div class="empty" style="padding:2rem">Keine Angebote gefunden.</div>
                {% else %}
                    <div class="table-wrap"><table class="data">
                        <thead><tr><th>#</th><th>Anmerkung</th><th>Kunde</th><th>Termin</th><th></th></tr></thead>
                        <tbody>
                        {% for offer in offers %}
                            <tr>
                                <td class="id-cell">{{ offer.id }}</td>
                                <td class="is-strong">{{ offer.comment ?: '—' }}</td>
                                <td>{% if offer.customer %}{{ offer.customer.firstname }} {{ offer.customer.surname }}{% endif %}</td>
                                <td>{{ offer.termDate ? offer.termDate|date('d.m.Y') : '—' }}</td>
                                <td class="is-actions">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_offer_edit', {'id': offer.id}) }}">Öffnen</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table></div>
                {% endif %}
            </div>
        </div>

        <div class="card result-section">
            <div class="card-head">
                <h2>Aufträge</h2><span class="result-count">{{ tasks|length }}</span>
            </div>
            <div class="card-body is-flush">
                {% if tasks is empty %}
                    <div class="empty" style="padding:2rem">Keine Aufträge gefunden.</div>
                {% else %}
                    <div class="table-wrap"><table class="data">
                        <thead><tr><th>#</th><th>Kunde</th><th>Termin</th><th></th></tr></thead>
                        <tbody>
                        {% for task in tasks %}
                            <tr>
                                <td class="id-cell">{{ task.id }}</td>
                                <td class="is-strong">{% if task.customer %}{{ task.customer.firstname }} {{ task.customer.surname }}{% endif %}</td>
                                <td>{{ task.taskDate ? task.taskDate|date('d.m.Y') : '—' }}</td>
                                <td class="is-actions">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_task_edit', {'id': task.id}) }}">Öffnen</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table></div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
