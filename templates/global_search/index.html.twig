{% extends 'base.html.twig' %}

{% block title %}Customer index{% endblock %}

{% block body %}
    <h1><i class="fas fa-users"></i> Kunden</h1>

    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Vorname</th>
            <th>Nachname</th>
            <th>E-Mail</th>
            <th>Telefon</th>
            <th>Mobil</th>
            <th>Straße</th>
            <th>Hsnr.</th>
            <th>PLZ</th>
            <th>Ort</th>
            <th>Aktionen</th>
        </tr>
        </thead>
        <tbody>
        {% for customer in customers %}
            <tr>
                <td>{{ customer.id }}</td>
                <td>{{ customer.firstname }}</td>
                <td>{{ customer.surname }}</td>
                <td>{{ customer.email }}</td>
                <td>{{ customer.phone }}</td>
                <td>{{ customer.mobilenumber }}</td>
                <td>{{ customer.street }}</td>
                <td>{{ customer.housenumber }}</td>
                <td>{{ customer.plz }}</td>
                <td>{{ customer.city }}</td>
                <td>
                    <a class="btn btn-info btn-circle btn-sm" href="{{ path('app_customer_edit', {'id': customer.id}) }}"><i class="fas fa-info-circle"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">Keine Einträge gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <br>
    <h1><i class="fas fa-file-invoice"></i> Angebote</h1>

    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Vorname</th>
            <th>Nachname</th>
            <th>E-Mail</th>
            <th>Telefon</th>
            <th>Mobil</th>
            <th>Straße</th>
            <th>Hsnr.</th>
            <th>PLZ</th>
            <th>Ort</th>
            <th>Aktionen</th>
        </tr>
        </thead>
        <tbody>
        {% for offer in offers %}
            <tr>
                <td>{{ offer.id }}</td>
                <td>{{ offer.customer.firstname }}</td>
                <td>{{ offer.customer.surname }}</td>
                <td>{{ offer.customer.email }}</td>
                <td>{{ offer.customer.phone }}</td>
                <td>{{ offer.customer.mobilenumber }}</td>
                <td>{{ offer.customer.street }}</td>
                <td>{{ offer.customer.housenumber }}</td>
                <td>{{ offer.customer.plz }}</td>
                <td>{{ offer.customer.city }}</td>
                <td>
                    <a class="btn btn-info btn-circle btn-sm" href="{{ path('app_offer_edit', {'id': offer.id}) }}"><i class="fas fa-info-circle"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">Keine Einträge gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <br>
    <h1><i class="fas fa-fw fa-wrench"></i> Aufträge</h1>
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Vorname</th>
            <th>Nachname</th>
            <th>E-Mail</th>
            <th>Telefon</th>
            <th>Mobil</th>
            <th>Straße</th>
            <th>Hsnr.</th>
            <th>PLZ</th>
            <th>Ort</th>
            <th>Aktionen</th>
        </tr>
        </thead>
        <tbody>
        {% for task in tasks %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.customer.firstname }}</td>
                <td>{{ task.customer.surname }}</td>
                <td>{{ task.customer.email }}</td>
                <td>{{ task.customer.phone }}</td>
                <td>{{ task.customer.mobilenumber }}</td>
                <td>{{ task.customer.street }}</td>
                <td>{{ task.customer.housenumber }}</td>
                <td>{{ task.customer.plz }}</td>
                <td>{{ task.customer.city }}</td>
                <td>
                    <a class="btn btn-info btn-circle btn-sm" href="{{ path('app_task_edit', {'id': task.id}) }}"><i class="fas fa-info-circle"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">Keine Einträge gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}