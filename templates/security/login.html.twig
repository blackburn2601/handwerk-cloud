<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Anmelden · HandwerkCloud</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
{% import '_icons.html.twig' as ui %}

<div class="auth">
    <aside class="auth-aside">
        <img src="{{ asset('img/logo.svg') }}" alt="">
        <h1>HandwerkCloud</h1>
        <p>Kunden, Angebote und Aufträge — vom Büro bis auf die Baustelle.</p>
        <ul class="auth-points">
            <li>{{ ui.icon('file') }} Angebote per Klick in Aufträge überführen</li>
            <li>{{ ui.icon('image') }} Fotos direkt vom Einsatzort</li>
            <li>{{ ui.icon('brush') }} Skizzen mit Finger oder Stift</li>
        </ul>
    </aside>

    <main class="auth-main">
        <div class="auth-form">
            <h2>Anmelden</h2>
            <p class="lede">Willkommen zurück. Bitte melden Sie sich an.</p>

            <form method="post">
                {% if error %}
                    <div class="flash is-danger" role="alert" style="margin-bottom:1rem">
                        {{ ui.icon('alert') }}
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                <div class="field">
                    <label for="inputEmail">E-Mail</label>
                    <input type="email" id="inputEmail" name="email" value="{{ last_username }}"
                           autocomplete="email" required autofocus placeholder="name@betrieb.de">
                </div>

                <div class="field">
                    <label for="inputPassword">Passwort</label>
                    <input type="password" id="inputPassword" name="password"
                           autocomplete="current-password" required placeholder="••••••••">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary" type="submit">Anmelden</button>
            </form>

            <div class="demo-hint">
                <strong>Demo-Zugänge</strong><br>
                Administrator: <code>admin@handwerkcloud.test</code><br>
                Monteur: <code>monteur@handwerkcloud.test</code><br>
                Passwort jeweils: <code>demo1234</code>
            </div>
        </div>
    </main>
</div>
</body>
</html>
