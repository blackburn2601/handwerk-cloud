{% extends 'base.html.twig' %}

{% block title %}New Customer{% endblock %}

{% block body %}
    <h1><i class="fas fa-users"></i> Kunde anlegen</h1>

    {{ form_start(form) }}
    <div class="my-custom-class-for-errors">
        {{ form_errors(form) }}
    </div>

    <div class="row">
        <div class="col">
            {{ form_row(form.firstname, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.surname, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.title, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.email, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.street, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.housenumber, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.plz, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.city, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.phone, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
        <div class="col">
            {{ form_row(form.mobilenumber, {'attr': {'class': 'form-control border-1 small'}}) }}
        </div>
    </div>
    <br>
    <button class="btn btn-success btn-icon-split">
        <span class="icon text-white-50">
            <i class="fas fa-check"></i>
        </span>
        <span class="text">{{ button_label|default('Speichern') }}</span>
    </button>
    {{ form_end(form) }}
    <br>
    <a href="{{ path('app_customer_index') }}">Zurück zur Übersicht</a>
{% endblock %}
