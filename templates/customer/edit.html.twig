{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}{{ customer.firstname }} {{ customer.surname }} · HandwerkCloud{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_customer_index') }}">{{ ui.icon('arrow-left', 15) }} Zurück zur Übersicht</a>

    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('users', 20) }}</span>
            <div>
                <h1>{{ customer.firstname }} {{ customer.surname }}</h1>
                <div class="page-sub">{{ customer.plz }} {{ customer.city }}</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('customer/_form.html.twig', {'delete_form': true}) }}
        </div>
    </div>
{% endblock %}
