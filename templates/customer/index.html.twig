{% extends 'base.html.twig' %}

{% block title %}Customer index{% endblock %}

{% block body %}
    <h1><i class="fas fa-users"></i> Kunden</h1>
    <a href="{{ path('app_customer_new') }}" class="btn btn-primary">
        <span class="text">+</span>
    </a>
    <br>
    <br>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Vorname</th>
                <th>Nachname</th>
                <th>E-Mail</th>
                <th>Telefon</th>
                <th>Mobil</th>
                <th>Straße</th>
                <th>Hsnr.</th>
                <th>PLZ</th>
                <th>Ort</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
        {% for customer in customers %}
            <tr>
                <td>{{ customer.id }}</td>
                <td>{{ customer.firstname }}</td>
                <td>{{ customer.surname }}</td>
                <td>{{ customer.email }}</td>
                <td>{{ customer.phone }}</td>
                <td>{{ customer.mobilenumber }}</td>
                <td>{{ customer.street }}</td>
                <td>{{ customer.housenumber }}</td>
                <td>{{ customer.plz }}</td>
                <td>{{ customer.city }}</td>
                <td>
                    <a class="btn btn-info btn-circle btn-sm" href="{{ path('app_customer_edit', {'id': customer.id}) }}"><i class="fas fa-info-circle"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">Keine Einträge gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
