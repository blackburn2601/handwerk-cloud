{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ui %}

{% block title %}Kunden · HandwerkCloud{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="page-title">
            <span class="page-title-icon">{{ ui.icon('users', 20) }}</span>
            <div>
                <h1>Kunden</h1>
                <div class="page-sub">{{ customers|length }} {{ customers|length == 1 ? 'Eintrag' : 'Einträge' }}</div>
            </div>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" href="{{ path('app_customer_new') }}">{{ ui.icon('plus') }} Kunde anlegen</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body is-flush">
            {% if customers is empty %}
                <div class="empty">
                    {{ ui.icon('users', 40) }}
                    <p>Noch keine Kunden erfasst.</p>
                    <a class="btn btn-primary" href="{{ path('app_customer_new') }}">{{ ui.icon('plus') }} Ersten Kunden anlegen</a>
                </div>
            {% else %}
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Kontakt</th>
                            <th>Adresse</th>
                            <th>Ort</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for customer in customers %}
                            <tr>
                                <td class="id-cell">{{ customer.id }}</td>
                                <td class="is-strong">
                                    {{ customer.firstname }} {{ customer.surname }}
                                    {% if customer.title %}<div class="muted" style="font-size:.8rem">{{ customer.title }}</div>{% endif %}
                                </td>
                                <td>
                                    {{ customer.phone }}
                                    {% if customer.email %}<div class="muted" style="font-size:.8rem">{{ customer.email }}</div>{% endif %}
                                </td>
                                <td>{{ customer.street }} {{ customer.housenumber }}</td>
                                <td>{{ customer.plz }} {{ customer.city }}</td>
                                <td class="is-actions">
                                    <a class="btn btn-secondary btn-sm" href="{{ path('app_customer_edit', {'id': customer.id}) }}">
                                        {{ ui.icon('pencil', 15) }} Bearbeiten
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
