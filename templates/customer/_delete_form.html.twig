{% import '_icons.html.twig' as ui %}

<form method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}"
      data-confirm="Möchten Sie den Kunden wirklich löschen?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
    <button class="btn btn-danger" type="submit">{{ ui.icon('trash') }} Löschen</button>
</form>
