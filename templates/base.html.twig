<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{% block title %}HandwerkCloud{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% import '_icons.html.twig' as ui %}

{% set route = app.request.attributes.get('_route') %}

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="{{ path('app_home') }}">
            <img src="{{ asset('img/logo.svg') }}" alt="">
            <span>
                <span class="brand-name">HandwerkCloud</span>
                <span class="brand-sub">Auftragsverwaltung</span>
            </span>
        </a>

        <nav class="nav">
            <a class="nav-item {{ route == 'app_home' ? 'is-active' }}" href="{{ path('app_home') }}">
                {{ ui.icon('dashboard') }} Dashboard
            </a>

            <div class="nav-label">Allgemein</div>
            <a class="nav-item {{ route starts with 'app_customer' ? 'is-active' }}" href="{{ path('app_customer_index') }}">
                {{ ui.icon('users') }} Kunden
            </a>
            <a class="nav-item {{ route starts with 'app_offer' ? 'is-active' }}" href="{{ path('app_offer_index') }}">
                {{ ui.icon('file') }} Angebote
            </a>
            <a class="nav-item {{ route starts with 'app_task' ? 'is-active' }}" href="{{ path('app_task_index') }}">
                {{ ui.icon('wrench') }} Aufträge
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <div class="nav-label">Administration</div>
                <a class="nav-item {{ route starts with 'app_user' ? 'is-active' }}" href="{{ path('app_user_index') }}">
                    {{ ui.icon('user-cog') }} Benutzer
                </a>
            {% endif %}
        </nav>

        <div class="sidebar-foot">HandwerkCloud &middot; Demo</div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="nav-toggle" type="button" data-nav-toggle aria-label="Navigation umschalten">
                {{ ui.icon('menu', 20) }}
            </button>

            <form class="search" method="get" action="{{ path('app_global_search') }}" role="search">
                {{ ui.icon('search') }}
                <label class="sr-only" for="global-search">Suchen</label>
                <input id="global-search" type="search" name="search" placeholder="Kunden, Angebote, Aufträge suchen …"
                       value="{{ app.request.query.get('search') }}">
            </form>

            <div class="topbar-right">
                {% if app.user %}
                    <div class="user-chip">
                        <div class="user-meta">
                            <div class="user-name">{{ app.user.firstname }} {{ app.user.surname }}</div>
                            <div class="user-role">{{ is_granted('ROLE_ADMIN') ? 'Administrator' : 'Monteur' }}</div>
                        </div>
                        <div class="avatar" aria-hidden="true">
                            {{- app.user.firstname|slice(0, 1)|upper }}{{ app.user.surname|slice(0, 1)|upper -}}
                        </div>
                    </div>
                    <a class="btn btn-ghost btn-icon" href="{{ path('app_logout') }}" title="Abmelden" aria-label="Abmelden">
                        {{ ui.icon('logout') }}
                    </a>
                {% endif %}
            </div>
        </header>

        <main class="content">
            <div class="content-inner">
                {% set allFlashes = app.flashes %}
                {% if allFlashes is not empty %}
                    <div class="flashes">
                        {% for type, messages in allFlashes %}
                            {% for message in messages %}
                                {% set kind = type == 'danger' ? 'danger' : (type == 'info' ? 'info' : 'success') %}
                                <div class="flash is-{{ kind }}" role="status">
                                    {{ ui.icon(kind == 'danger' ? 'alert' : (kind == 'info' ? 'info' : 'check')) }}
                                    <span>{{ message }}</span>
                                    <button class="flash-close" type="button" data-flash-close aria-label="Schließen">&times;</button>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% block body %}{% endblock %}
            </div>
        </main>
    </div>
</div>

<script src="{{ asset('js/app.js') }}" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>
