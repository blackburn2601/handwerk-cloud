# Default environment values, committed on purpose (Symfony convention).
# Real secrets belong in .env.local, which is gitignored and overrides this file.
#
# See https://symfony.com/doc/current/configuration.html#overriding-environment-values-via-env-local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Matches the MySQL service in compose.yaml.
DATABASE_URL="mysql://handwerk:handwerk@127.0.0.1:13306/handwerk?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
